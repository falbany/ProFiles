# Normalize all line endings to LF in the repository and working tree.
# Kills the recurring CRLF→LF churn in src/profiles/web/dist/ and keeps
# web builds reproducible for contributors on Windows.
* text=auto eol=lf

# Binary assets (never touch)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.icns binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.dmg binary
*.msi binary
*.deb binary

# Windows batch files need CRLF (cmd.exe has LF edge cases, e.g. around
# labels); BMPs are binary. Used by packaging/windows/ installer scripts
# and img/installer_*.bmp — see the installer polish design (issue #183).
*.bat text eol=crlf
*.bmp binary
